#include <iostream>
int main() {
    double x;
    int n;
    std::cout << "Enter x: " << std::endl;
    std::cin>>x;
    std::cout << "Enter n: " << std::endl;
    std::cin >> n;
    if (n == 0) {
        std::cout << 1 << std::endl;
        return 0;
    }
    bool is_negative = n < 0;
    if (is_negative) {
        n = -n; 
    }
    double x_c = x;
    for (int i = 1; i < n; i++) {
        x = x * x_c;
    }
    if (is_negative) {
        x = 1.0 / x;
    }
    std::cout << x << std::endl;
    return 0;
}
